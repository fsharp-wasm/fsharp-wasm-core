<Project Sdk="Microsoft.NET.Sdk">
  <!-- FSharp.Wasm.Actors: processes the way Erlang/OTP has them, as pure state machines.  A supervisor (one_for_one, one_for_all, restart intensity, give up and escalate) and a pool of
       workers (a mailbox per worker, at-least-once delivery with idempotent completion, the jobs of a worker that died go back to the queue) are functions of an event and a state that
       give a new state and commands; the world (Web Workers, threads, a test's scheduler) carries the commands out and reports what happened.  Nothing to depend on; runs under .NET and
       as WasmGC and is tested both ways (tests/FSharp.Wasm.Libs.Tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>Processes the way Erlang/OTP has them, as pure state machines: supervisors with restart strategies and a pool of workers with at-least-once delivery. Runs under .NET and as WebAssembly GC.</Description>
    <PackageTags>actors;supervisor;otp</PackageTags>
    <RootNamespace>FSharp.Wasm.Actors</RootNamespace>
    <PackageId>FSharp.Wasm.Actors</PackageId>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Wasm.Core/FSharp.Wasm.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Supervisor.fs" />
    <Compile Include="Pool.fs" />
  </ItemGroup>
</Project>

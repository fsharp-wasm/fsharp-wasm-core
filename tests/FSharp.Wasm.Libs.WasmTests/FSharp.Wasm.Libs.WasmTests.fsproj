<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of FSharp.Wasm.Data and FSharp.Wasm.Ui, written with Wasmecto.  Tests: `bash build/test.sh dotnet`; WasmTests: compiled by fsharp-wasm (`bash build/test.sh wasm`). -->
  <PropertyGroup>
    <AssemblyName>WasmTests</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
    <FSHARP_WASM_CORE_DIR Condition="'$(FSHARP_WASM_CORE_DIR)' == ''">$(MSBuildThisFileDirectory)../..</FSHARP_WASM_CORE_DIR>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FSharp.Wasm.Libs.Tests/DataTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/UiTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/EditTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/IconsTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/FrameTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/FormulaTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/GraphTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/DesignTests.fs" />
    <Compile Include="../FSharp.Wasm.Libs.Tests/ActorsTests.fs" />
    <Compile Include="WasmTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../FSharp.Wasm.Data/FSharp.Wasm.Data.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Ui/FSharp.Wasm.Ui.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Edit/FSharp.Wasm.Edit.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Frame/FSharp.Wasm.Frame.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Graph/FSharp.Wasm.Graph.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Formula/FSharp.Wasm.Formula.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Design/FSharp.Wasm.Design.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Actors/FSharp.Wasm.Actors.fsproj" />
    <ProjectReference Include="../../FSharp.Wasm.Icons/FSharp.Wasm.Icons.fsproj" />
    <ProjectReference Include="../../lib/wasmecto/src/Wasmecto.fsproj" />
  </ItemGroup>
</Project>

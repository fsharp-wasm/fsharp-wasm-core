<Project Sdk="Microsoft.NET.Sdk">
  <!-- FSharp.Wasm.Icons: icons as typed shapes on a 24 x 24 grid (stroke only, round ends and joins), drawn the same everywhere: as SVG markup, as the elements of a DOM
       view, as paths on a canvas.  The set is Lucide (ISC, with some icons of Feather under MIT), generated by tools/icons/generate.mjs; LICENSES/ISC-MIT-lucide.txt.
       No dependencies, no rendering of its own beyond the SVG text, so it runs under .NET and as WasmGC. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>Icons as typed shapes on a 24 x 24 grid (the Lucide set), drawn the same everywhere: SVG markup, DOM elements, canvas paths. Runs under .NET and as WebAssembly GC.</Description>
    <PackageTags>icons;svg;lucide</PackageTags>
    <RootNamespace>FSharp.Wasm.Icons</RootNamespace>
    <PackageId>FSharp.Wasm.Icons</PackageId>
    <PackageLicenseExpression>Apache-2.0 AND ISC AND MIT</PackageLicenseExpression>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Icons.fs" />
    <Compile Include="Lucide.fs" />
  </ItemGroup>
</Project>

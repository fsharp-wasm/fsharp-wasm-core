<!-- FSharp.Wasm.Core — the F# base library of programs compiled by fsharp-wasm (WasmGC).
     Source-only: a program compiles these files together with its own (see FSharp.Wasm.Core.props); nothing here is a
     binary dependency.  The project exists so that an IDE and `dotnet build` can check the sources under .NET too. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>FSharp.Wasm.Core</PackageId>
    <Description>F# base library (System.* surface, Option, Result, collections, math helpers, host-interop attributes) for programs compiled by fsharp-wasm to WebAssembly GC.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>base-library;bcl</PackageTags>
    <RootNamespace>FSharp.Wasm.Core</RootNamespace>
    <AssemblyName>FSharp.Wasm.Core</AssemblyName>
  </PropertyGroup>

  <!-- the whole library, in compilation order (a program imports the same list, or the groups of it that it needs) -->
  <PropertyGroup>
    <FSharpWasmCoreOnly>Interop;Bcl;Option;Result;Collections;Lists;Math</FSharpWasmCoreOnly>
  </PropertyGroup>
  <Import Project="FSharp.Wasm.Core.props" />

  <!-- The package puts the sources into the program by a props file that NuGet imports (build/), not by a project of their own under fable/: a project of their own is
       a reference, and the type of the program's `Dictionary` stays the BCL's then. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <Content Remove="FSharp.Wasm.Core.fsproj" />
    <None Include="build/FSharp.Wasm.Core.props" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>

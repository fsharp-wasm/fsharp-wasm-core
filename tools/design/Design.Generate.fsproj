<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes design/tokens.css and design/tokens.json from FSharp.Wasm.Design; with the flag check it writes nothing and fails when the files in the repository are not what the tokens give. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../FSharp.Wasm.Design/FSharp.Wasm.Design.fsproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- FSharp.Wasm.Design: the look of the platform as data, in one place — the colour ramps, the roles a page and a widget read (light and dark), the scales of space, type,
       radius and motion, the contrast the pairs of roles have to keep, and the exports: CSS custom properties (prefix fw) and JSON.  The site, the runtime's CSS, the canvas
       widgets and the newsletter read these values instead of keeping a copy.  Typed CSS and colour come from FSharp.Wasm.Ui, JSON from FSharp.Wasm.Data;
       runs under .NET and as WasmGC and is tested both ways (tests/FSharp.Wasm.Libs.Tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>FSharp.Wasm.Design</RootNamespace>
    <PackageId>FSharp.Wasm.Design</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fsharp-wasm/fsharp-wasm-core</RepositoryUrl>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Wasm.Ui/FSharp.Wasm.Ui.fsproj" />
    <ProjectReference Include="../FSharp.Wasm.Data/FSharp.Wasm.Data.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Palette.fs" />
    <Compile Include="Tokens.fs" />
    <Compile Include="Export.fs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- FSharp.Wasm.Telemetry: what a dashboard or a SCADA screen needs that is not drawing: the samples of a tag with their quality, the alarm of a tag as the state machine of ISA-18.2
       (limits with a deadband and a delay, active / acknowledged / returned, escalation, shelving) and the compression of a history by deadband.  Pure functions of a sample and a
       state; the effects (a horn, a log, a message) are the events they return.  Depends on the base library only; runs under .NET and as WasmGC and is tested both ways. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>What a dashboard or SCADA screen needs that is not drawing: samples with quality, the ISA-18.2 alarm state machine and the compression of a history by deadband. Runs under .NET and as WebAssembly GC.</Description>
    <PackageTags>scada;alarms;telemetry</PackageTags>
    <RootNamespace>FSharp.Wasm.Telemetry</RootNamespace>
    <PackageId>FSharp.Wasm.Telemetry</PackageId>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Wasm.Core/FSharp.Wasm.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Alarm.fs" />
    <Compile Include="Historian.fs" />
  </ItemGroup>
</Project>
